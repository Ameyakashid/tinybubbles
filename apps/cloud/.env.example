# Tiny Bubbles Cloud example environment.
# Copy to .env for local development and replace placeholders before use.

# Network binding
HOST=0.0.0.0
PORT=8787
# NODE_ENV=production

# Authentication
# Use long random bearer tokens. Comma-separate multiple tokens.
TINYBUBBLES_CLOUD_AUTH_TOKENS=replace-with-a-long-random-token
# TINYBUBBLES_CLOUD_AUTH_TOKENS_FILE=/run/secrets/tinybubbles_cloud_tokens
# Deprecated legacy single-token aliases; prefer TINYBUBBLES_CLOUD_AUTH_TOKENS.
# TINYBUBBLES_CLOUD_TOKEN=
# TINYBUBBLES_CLOUD_TOKEN_FILE=
# Development/testing only.
# TINYBUBBLES_CLOUD_ALLOW_ANY_TOKEN=false
# TINYBUBBLES_CLOUD_ANY_TOKEN_MAX_NAMESPACES=32

# Browser origin and storage
TINYBUBBLES_CLOUD_CORS_ORIGIN=http://localhost:5173
TINYBUBBLES_CLOUD_DATA_DIR=./data

# Reverse proxy handling for auth-failure rate limiting
TINYBUBBLES_CLOUD_TRUST_PROXY_HEADERS=false
# TINYBUBBLES_CLOUD_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Request limits
TINYBUBBLES_CLOUD_MAX_BODY_BYTES=2000000
TINYBUBBLES_CLOUD_MAX_ATTACHMENT_BYTES=50000000
TINYBUBBLES_CLOUD_REQUEST_TIMEOUT_MS=30000
# Failures and slow requests are logged by default. Enable this only when every
# privacy-safe request completion should be logged.
TINYBUBBLES_CLOUD_LOG_ALL_REQUESTS=false
TINYBUBBLES_CLOUD_SLOW_REQUEST_MS=1000
TINYBUBBLES_CLOUD_MAX_TASK_TITLE_LENGTH=500
TINYBUBBLES_CLOUD_MAX_TASK_QUICK_ADD_LENGTH=2000
TINYBUBBLES_CLOUD_MAX_ITEMS_PER_COLLECTION=50000

# Pagination and list shaping
TINYBUBBLES_CLOUD_LIST_DEFAULT_LIMIT=200
TINYBUBBLES_CLOUD_LIST_MAX_LIMIT=1000

# Rate limiting
TINYBUBBLES_CLOUD_RATE_WINDOW_MS=60000
TINYBUBBLES_CLOUD_RATE_MAX=120
TINYBUBBLES_CLOUD_ATTACHMENT_RATE_MAX=120
TINYBUBBLES_CLOUD_RATE_CLEANUP_MS=60000
TINYBUBBLES_CLOUD_RATE_MAX_KEYS=10000
TINYBUBBLES_CLOUD_AUTH_FAILURE_RATE_MAX=30
