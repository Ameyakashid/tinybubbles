{
  "name": "tinybubbles-mcp",
  "description": "Stdio MCP server for Tiny Bubbles local and self-hosted Cloud task access.",
  "version": "1.1.4",
  "license": "AGPL-3.0-only",
  "type": "module",
  "mcpName": "io.github.Ameyakashid/tinybubbles",
  "main": "dist/index.js",
  "bin": {
    "tinybubbles-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ameyakashid/tinybubbles.git",
    "directory": "apps/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/Ameyakashid/tinybubbles/issues"
  },
  "homepage": "https://github.com/Ameyakashid/tinybubbles/tree/main/apps/mcp-server",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tinybubbles",
    "gtd",
    "tasks"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --target node --format esm --outfile dist/index.js --define process.env.NODE_ENV='\"production\"' --external=better-sqlite3 --external=bun:sqlite",
    "lint": "eslint -c eslint.config.mjs . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.1"
  }
}
